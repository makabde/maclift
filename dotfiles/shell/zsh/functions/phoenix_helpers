#!/usr/bin/env zsh
command -v elixir >/dev/null 2>&1 || return 0

# Phoenix development helper functions

# Create a new Phoenix project with Docker Compose setup
phnx_new() {
  local app_name=$1
  local flags=${@:2}

  if [ -z "$app_name" ]; then
    echo "Usage: phnx_new <app_name> [flags]"
    echo "Example: phnx_new myapp --no-ecto"
    return 1
  fi

  # Create Phoenix project
  echo "Creating Phoenix project: $app_name"
  mix phx.new "$app_name" $flags || return 1

  cd "$app_name" || return 1

  # Add .tool-versions for version pinning
  echo "Adding .tool-versions..."
  cat > .tool-versions <<'EOF'
erlang 29.1.2
elixir 1.20.4-otp-29
nodejs 26.12.1
EOF

  # Copy Docker Compose template
  echo "Setting up Docker Compose..."
  if [ -f "$HOME/.maclift/templates/phoenix-docker/docker-compose.yml" ]; then
    cp "$HOME/.maclift/templates/phoenix-docker/docker-compose.yml" .

    # Replace PROJECT_NAME placeholder
    if command -v gsed &>/dev/null; then
      gsed -i "s/\${PROJECT_NAME:-app}/$app_name/g" docker-compose.yml
    else
      sed -i '' "s/\${PROJECT_NAME:-app}/$app_name/g" docker-compose.yml
    fi
  else
    echo "Warning: Docker template not found at ~/.maclift/templates/phoenix-docker/docker-compose.yml"
  fi

  # Create .env file
  echo "Creating .env file..."
  cat > .env <<EOF
PROJECT_NAME=$app_name
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgres://postgres:postgres@localhost:5432/${app_name}_dev
EOF

  # Add .env to .gitignore if not already there
  if ! grep -q "^\.env$" .gitignore 2>/dev/null; then
    echo ".env" >> .gitignore
  fi

  echo ""
  echo "✅ Phoenix app '$app_name' created!"
  echo ""
  echo "Next steps:"
  echo "  1. Start Docker services: docker compose up -d"
  echo "  2. Install dependencies: mix deps.get"
  echo "  3. Create database: mix ecto.create"
  echo "  4. Run migrations: mix ecto.migrate"
  echo "  5. Start Phoenix: mix phx.server (or 'ps')"
  echo ""
  echo "Docker services:"
  echo "  📊 PostgreSQL: localhost:5432"
  echo "  🔴 Redis: localhost:6379"
  echo "  📧 MailCatcher: http://localhost:1080"
  echo ""
  echo "Shortcuts:"
  echo "  docker.up    - Start all services"
  echo "  docker.down  - Stop all services"
  echo "  db.setup     - Start Docker + setup database"
  echo "  ps           - Start Phoenix server"
  echo "  psd          - Start Phoenix with IEx"
}

# Quick Phoenix project setup (new + Docker + deps + db)
phnx_quick() {
  local app_name=$1
  local flags=${@:2}

  phnx_new "$app_name" $flags || return 1

  echo ""
  echo "Starting Docker services..."
  docker compose up -d || return 1

  echo "Waiting for PostgreSQL to be ready..."
  local retries=30
  until docker compose exec -T postgres pg_isready -U postgres &>/dev/null || [ $retries -eq 0 ]; do
    sleep 1
    ((retries--))
  done

  if [ $retries -eq 0 ]; then
    echo "Error: PostgreSQL failed to start"
    return 1
  fi

  echo "Installing dependencies..."
  mix deps.get || return 1

  echo "Setting up database..."
  mix ecto.setup || return 1

  echo ""
  echo "🎉 Project ready! Start with: mix phx.server (or 'ps')"
}

# Open Phoenix routes in browser
phnx_routes() {
  mix phx.routes
}

# Open LiveDashboard (if running)
phnx_dash() {
  local port=${1:-4000}
  open "http://localhost:$port/dev/dashboard"
}

# Run Phoenix tests with Docker services
phnx_test() {
  if ! docker compose ps postgres | grep -q "Up"; then
    echo "Starting PostgreSQL..."
    docker compose up -d postgres
    sleep 2
  fi

  MIX_ENV=test mix test "$@"
}

# Clean up Phoenix project (stop Docker, clean build)
phnx_clean() {
  echo "Stopping Docker services..."
  docker compose down -v

  echo "Cleaning build artifacts..."
  mix clean
  rm -rf _build deps

  echo "✅ Project cleaned"
}

# Show Phoenix project info
phnx_info() {
  echo "Phoenix Project Information"
  echo "============================"
  echo ""

  if [ -f "mix.exs" ]; then
    local app_name=$(grep "app:" mix.exs | sed 's/.*app: :\([^,]*\).*/\1/')
    echo "App: $app_name"

    if command -v mix &>/dev/null; then
      echo "Elixir: $(elixir --version | grep Elixir | awk '{print $2}')"
      echo "Erlang: $(erl -eval 'erlang:display(erlang:system_info(otp_release)), halt().' -noshell)"
    fi
  fi

  echo ""
  echo "Docker Services:"
  docker compose ps

  echo ""
  echo "Database:"
  if docker compose exec -T postgres pg_isready -U postgres &>/dev/null; then
    echo "  ✅ PostgreSQL is ready"
  else
    echo "  ❌ PostgreSQL is not running"
  fi
}
