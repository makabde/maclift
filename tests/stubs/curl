#!/usr/bin/env bash
# Test stub for curl. State lives in $MACLIFT_STUB_DIR:
#   curl.calls       one line per invocation (all args)
#   curl.fail        if present, exits 22 (like curl -f on an HTTP error)
#   curl.signal      if present, holds a signal name (TERM, HUP, INT): sends
#                    it to the caller, then exits 22
#   release.tar.gz   what a download returns: copied to the -o target, or to
#                    stdout without -o
d="${MACLIFT_STUB_DIR:?}"
echo "$*" >>"$d/curl.calls"
if [ -e "$d/curl.signal" ]; then kill -"$(cat "$d/curl.signal")" "$PPID"; exit 22; fi
[ -e "$d/curl.fail" ] && { echo "curl: (22) The requested URL returned error: 404" >&2; exit 22; }
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ -n "$out" ]; then
  cp "$d/release.tar.gz" "$out"
else
  cat "$d/release.tar.gz"
fi
