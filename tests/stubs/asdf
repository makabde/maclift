#!/usr/bin/env bash
# Test stub for asdf. `latest` answers can be overridden per plugin with
# MACLIFT_STUB_LATEST_<PLUGIN> (plugin upper-cased, - as _, e.g. ..._NODEJS).
# Installed plugins: $MACLIFT_STUB_DIR/asdf.plugins, one name per line. When
# that file exists, `plugin list` prints it, `plugin add` appends to it, and
# `latest` fails for a plugin not in it. Without the file every plugin counts
# as installed.
plugins="${MACLIFT_STUB_DIR:-/nonexistent}/asdf.plugins"
case "$1" in
  latest)
    [ -n "${MACLIFT_STUB_DIR:-}" ] && echo "$*" >>"$MACLIFT_STUB_DIR/asdf.calls"
    if [ -f "$plugins" ] && ! grep -Fxq "$2" "$plugins"; then
      echo "unable to load latest version: Plugin named $2 not installed" >&2
      exit 1
    fi
    up="$(printf '%s' "$2" | tr '[:lower:]-' '[:upper:]_')"
    ov="MACLIFT_STUB_LATEST_$up"
    if [ -n "${!ov:-}" ]; then printf '%s\n' "${!ov}"; exit 0; fi
    case "$2" in
      erlang) echo 27.3.4 ;;
      nodejs) echo 24.5.1 ;;
      python) echo 3.13.5 ;;
      *) exit 1 ;;
    esac
    ;;
  list)
    if [ "$2" = all ] && [ "$3" = elixir ]; then
      printf '%s\n' 1.18.3-otp-27 1.18.4-otp-26 1.18.4-otp-27 1.19.0-otp-28 1.19.0-rc.1-otp-27 1.9.0-otp-27 main
      exit 0
    fi
    exit 1
    ;;
  plugin)
    [ -n "${MACLIFT_STUB_DIR:-}" ] && echo "$*" >>"$MACLIFT_STUB_DIR/asdf.calls"
    if [ "$2" = list ]; then
      if [ -f "$plugins" ]; then
        cat "$plugins"
      else
        # No asdf.plugins file: every plugin the tests use is installed.
        printf '%s\n' erlang elixir nodejs python fail-plugin
        env | sed -n 's/^MACLIFT_STUB_LATEST_\([A-Z0-9_]*\)=.*/\1/p' | tr 'A-Z_' 'a-z-'
      fi
      exit 0
    fi
    if [ "$2" = add ] && [ "$3" = "fail-plugin" ]; then
      exit 1
    fi
    if [ "$2" = add ] && [ -f "$plugins" ] && ! grep -Fxq "$3" "$plugins"; then
      echo "$3" >>"$plugins"
    fi
    exit 0
    ;;
  install)
    [ -n "${MACLIFT_STUB_DIR:-}" ] && echo "$*" >>"$MACLIFT_STUB_DIR/asdf.calls"
    if [ "$2" = "fail-plugin" ]; then
      # Snapshot ~/.tool-versions so tests can see what was applied by now.
      [ -n "${MACLIFT_STUB_DIR:-}" ] && cp "$MACLIFT_HOME/.tool-versions" "$MACLIFT_STUB_DIR/tool-versions.at-failure" 2>/dev/null
      exit 1
    fi
    [ -n "${MACLIFT_STUB_DIR:-}" ] && echo "$2 $3" >>"$MACLIFT_STUB_DIR/asdf.installed"
    echo "stub: asdf installed $2 $3"
    ;;
  where)
    [ -n "${MACLIFT_STUB_DIR:-}" ] && echo "$*" >>"$MACLIFT_STUB_DIR/asdf.calls"
    [ -n "${MACLIFT_STUB_DIR:-}" ] && grep -Fxq "$2 $3" "$MACLIFT_STUB_DIR/asdf.installed" 2>/dev/null
    ;;
  *) exit 1 ;;
esac
